<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.NenaSayuraApp" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash: shows the logo while the app starts, then switches to Theme.NenaSayuraApp -->
    <style name="Theme.NenaSayuraApp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#1A6B9B</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.NenaSayuraApp</item>
    </style>
</resources>